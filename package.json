{
  "name": "codelore-turbo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "npx concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=services/api-gateway\" \"npm run dev --workspace=services/core-engine/parser-service\"",
    "turbo:dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "services/core-engine/*"
  ]
}
